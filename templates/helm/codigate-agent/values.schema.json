{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "codigate-agent values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 0 },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^(sha256:[a-f0-9]{64})?$" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "imagePullSecrets": { "type": "array", "items": { "type": "object" } },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "token": {
      "type": "string",
      "description": "The agent token (cga_...). Prefer existingSecret."
    },
    "existingSecret": { "type": "string" },
    "existingSecretKey": { "type": "string", "minLength": 1 },
    "edge": { "type": "string", "pattern": "^(https?://\\S+)?$" },
    "config": {
      "type": "object",
      "description": "The agent config file without edge and token.",
      "properties": {
        "log_level": { "type": "string", "enum": ["debug", "info", "warn", "error"] },
        "ingress": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["service"],
            "properties": {
              "hostname": { "type": "string" },
              "service": {
                "type": "string",
                "pattern": "^(https?://|tcp://|ssh://|http_status:)"
              },
              "originRequest": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "noTLSVerify": { "type": "boolean" },
                  "httpHostHeader": { "type": "string" },
                  "originServerName": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "existingConfigMap": { "type": "string" },
    "existingConfigMapKey": { "type": "string", "minLength": 1 },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object" }
      }
    },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "resources": { "type": "object" },
    "priorityClassName": { "type": "string" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "topologySpreadConstraints": { "type": "array" },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": ["integer", "string", "null"] },
        "maxUnavailable": { "type": ["integer", "string", "null"] }
      }
    },
    "extraEnv": { "type": "array", "items": { "type": "object" } },
    "extraVolumes": { "type": "array", "items": { "type": "object" } },
    "extraVolumeMounts": { "type": "array", "items": { "type": "object" } },
    "global": { "type": "object" }
  }
}
