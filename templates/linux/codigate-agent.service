[Unit]
Description=Codigate agent
Documentation=https://github.com/codigate/agent
After=network-online.target
Wants=network-online.target

[Service]
User=codigate
Group=codigate
ExecStart=/usr/local/bin/codigate-agent --config /etc/codigate/codigate.yml
Restart=always
RestartSec=5
# Hardening: the agent only makes outbound connections and reads its config.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
